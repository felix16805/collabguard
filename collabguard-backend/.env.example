# CollabGuard Backend Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=collabguard

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=collabguard_neo4j_password

# Security & JWT
JWT_SECRET_KEY=collabguard_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Detection Engine Defaults
WINNOWING_K_GRAM=25
WINNOWING_WINDOW_SIZE=10
SIMILARITY_THRESHOLD=0.60
LOUVAIN_RESOLUTION=1.0
