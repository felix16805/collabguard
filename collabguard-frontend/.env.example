# CollabGuard — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git. It is in .gitignore by default.

# ─── Supabase ─────────────────────────────────────────────────────────────
# These are the only two env vars exposed to the client bundle (NEXT_PUBLIC_).
# The anon key is safe for client exposure — Row Level Security enforces access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Analytics ────────────────────────────────────────────────────────────
# Plausible Analytics — no cookies, no personal data.
# Set your Plausible domain here. Leave empty to disable analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=collabguard.vercel.app

# ─── Server-only (never NEXT_PUBLIC_) ─────────────────────────────────────
# These are for future use with the real FastAPI backend.
# They are never bundled into client code.
# FASTAPI_BASE_URL=http://localhost:8000
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # server-side only
